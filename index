 let v0=0;function viz(t){raf=requestAnimationFrame(viz);if(t-v0<50||document.hidden)return;v0=t;an.getByteFrequencyData(dt);bars.forEach((b,i)=>b.style.height=(4+dt[1+i*3]/255*16)+'px')}
 audio.addEventListener('play',()=>{try{if(!ac){ac=new(window.AudioContext||window.webkitAudioContext)();const sr=ac.createMediaElementSource(audio);an=ac.createAnalyser();an.fftSize=64;dt=new Uint8Array(an.frequencyBinCount);sr.connect(an);an.connect(ac.destination)}ac.resume();pl.classList.add('live');cancelAnimationFrame(raf);viz()}catch(e){pl.classList.remove('live')}});
 audio.addEventListener('pause',()=>{cancelAnimationFrame(raf);bars.forEach(b=>b.style.height='')});
})();
// performance: pause off-screen animations
(function(){if(!('IntersectionObserver' in window))return;const o=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('paused',!e.isIntersecting)),{rootMargin:'120px'});document.querySelectorAll('main section').forEach(x=>o.observe(x))})();
// particles
const cv=$('#fx'),cx=cv.getContext('2d');let W,H,ps=[];
let rt;function rs(){W=cv.width=innerWidth;H=cv.height=innerHeight}rs();addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(rs,150)});
const N=innerWidth<600?32:90;
for(let i=0;i<N;i++)ps.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*2+.4,vy:Math.random()*.5+.15,vx:(Math.random()-.5)*.3,a:Math.random()});
let sp=[];const GC=["#F7E7CE","#D4AF37","#fff2b8","#ffcc4d"];
function burst(x,y){for(let i=0;i<(innerWidth<600?70:110);i++){const a=Math.random()*6.28,s=Math.random()*7+2;sp.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,l:1,r:Math.random()*2.5+1,c:GC[i%4]})}}
const spr=document.createElement('canvas');spr.width=spr.height=32;(function(){const g=spr.getContext('2d'),r=g.createRadialGradient(16,16,0,16,16,16);r.addColorStop(0,'#fff6d8');r.addColorStop(.25,'#D4AF37');r.addColorStop(1,'rgba(212,175,55,0)');g.fillStyle=r;g.fillRect(0,0,32,32)})();
(function loop(){requestAnimationFrame(loop);if(document.hidden)return;cx.clearRect(0,0,W,H);
 for(let i=0;i<ps.length;i++){const p=ps[i];p.y-=p.vy;p.x+=p.vx;p.a+=.02;if(p.y<-5){p.y=H+5;p.x=Math.random()*W}cx.globalAlpha=.35+Math.sin(p.a)*.35;const d=p.r*5;cx.drawImage(spr,p.x-d/2,p.y-d/2,d,d)}
 if(sp.length>450)sp=sp.slice(-450);
 sp=sp.filter(s=>s.l>0);for(let i=0;i<sp.length;i++){const s=sp[i];s.x+=s.vx;s.y+=s.vy;s.vy+=.08;s.vx*=.985;s.l-=.012;cx.globalAlpha=Math.max(s.l,0);cx.fillStyle=s.c||'#F7E7CE';cx.fillRect(s.x-s.r,s.y-s.r,s.r*2,s.r*2)}
})();
