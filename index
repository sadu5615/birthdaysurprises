<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Happy Birthday Subash</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Noto+Sans+Sinhala:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#050505;--gold:#D4AF37;--champ:#F7E7CE;--glow:rgba(212,175,55,.45)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--champ);font-family:'Cormorant Garamond',Georgia,serif;font-size:1.2rem;overflow-x:hidden;-webkit-tap-highlight-color:transparent}
body.lock{overflow:hidden}
canvas#fx{position:fixed;inset:0;z-index:0;pointer-events:none}
.gold{background:linear-gradient(100deg,#8a6d1c,#D4AF37 30%,#fff2b8 50%,#D4AF37 70%,#8a6d1c);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 5s linear infinite}
@keyframes shine{to{background-position:200% center}}
h1,h2,h3,.cz{font-family:'Cinzel',serif;font-weight:700}
.btn{font-family:'Cinzel',serif;font-weight:700;letter-spacing:.12em;font-size:.85rem;color:#1a1300;background:linear-gradient(135deg,#f7e7ce,#D4AF37 45%,#8a6d1c);border:0;border-radius:50px;padding:1.05em 2em;cursor:pointer;box-shadow:0 0 25px var(--glow);position:relative;overflow:hidden;animation:pulse 2.4s ease-in-out infinite}
.btn:focus-visible,.nav a:focus-visible,.pbtn:focus-visible{outline:2px solid #fff;outline-offset:3px}
@keyframes pulse{50%{box-shadow:0 0 45px rgba(212,175,55,.8)}}
/* loader */
#loader{position:fixed;inset:0;z-index:100;background:#050505;display:grid;place-items:center;transition:opacity .8s}
.ring{width:70px;height:70px;border:2px solid rgba(212,175,55,.2);border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite;box-shadow:0 0 25px var(--glow)}
@keyframes spin{to{transform:rotate(360deg)}}
/* intro */
#intro{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:1.5rem;background:radial-gradient(ellipse at 50% 35%,#2a2008 0,#050505 65%);transition:opacity 1.2s,transform 1.2s}
#intro.out{opacity:0;transform:scale(1.15);pointer-events:none}
.crown{width:110px;filter:drop-shadow(0 0 18px var(--glow));animation:float 4s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-12px)}}
.kicker{font-family:'Cinzel',serif;letter-spacing:.5em;font-size:.7rem;color:var(--gold);margin:1.2rem 0 .8rem}
#intro h1{font-size:clamp(2rem,9vw,5rem);line-height:1.1;letter-spacing:.06em;margin-bottom:1rem}
#intro p{font-style:italic;font-size:clamp(1.1rem,3.5vw,1.6rem);margin-bottom:2.2rem;color:var(--champ)}
#count{position:fixed;inset:0;z-index:60;display:none;place-items:center;background:#050505}
#count span{font-family:'Cinzel',serif;font-size:min(40vw,16rem);animation:pop 1s ease-out both}
@keyframes pop{from{opacity:0;transform:scale(2.2)}60%{opacity:1}to{opacity:.0;transform:scale(.7)}}
/* player */
#player{position:fixed;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:40;display:none;align-items:center;gap:.6rem;padding:.5rem .8rem;background:rgba(20,16,4,.6);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(212,175,55,.5);border-radius:50px;box-shadow:0 0 20px rgba(212,175,55,.25)}
.pbtn{width:38px;height:38px;border-radius:50%;border:1px solid var(--gold);background:transparent;color:var(--gold);font-size:1rem;cursor:pointer}
.eq{display:flex;gap:3px;align-items:flex-end;height:20px}
.eq i{width:3px;background:var(--gold);height:6px;animation:eq 1s ease-in-out infinite;animation-play-state:paused}
.eq i:nth-child(2){animation-delay:.2s}.eq i:nth-child(3){animation-delay:.4s}.eq i:nth-child(4){animation-delay:.6s}
.playing .eq i{animation-play-state:running}
@keyframes eq{50%{height:20px}}
#vol{width:70px;accent-color:var(--gold)}
/* nav */
.nav{position:fixed;top:0;left:0;right:0;z-index:30;display:flex;justify-content:center;gap:clamp(.8rem,4vw,2.4rem);padding:calc(.9rem + env(safe-area-inset-top,0px)) 1rem .9rem;background:linear-gradient(#050505,transparent)}
.nav a{font-family:'Cinzel',serif;font-size:.7rem;letter-spacing:.2em;color:var(--champ);text-decoration:none;opacity:.8}
.nav a:hover{color:var(--gold);opacity:1}
/* sections */
main{position:relative;z-index:1;opacity:0;transition:opacity 1.6s}
main.show{opacity:1}
section{min-height:100vh;padding:6rem 1.2rem 4rem;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.glass{background:rgba(255,255,255,.04);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(212,175,55,.45);border-radius:22px;box-shadow:0 0 40px rgba(212,175,55,.12),inset 0 0 30px rgba(212,175,55,.05)}
h2{font-size:clamp(1.5rem,6vw,2.8rem);letter-spacing:.1em;margin-bottom:2rem}
#hero h1{font-size:clamp(2.4rem,11vw,6.5rem);letter-spacing:.05em;line-height:1.05}
#hero .age{font-family:'Cinzel',serif;font-size:clamp(5rem,28vw,15rem);line-height:1;margin:.5rem 0;text-shadow:0 0 60px var(--glow)}
#hero p{font-style:italic;font-size:clamp(1.1rem,3.5vw,1.7rem);max-width:30ch}
.rv{opacity:0;transform:translateY(30px);transition:opacity 1s,transform 1s}
.rv.in{opacity:1;transform:none}
/* gallery */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:2rem;width:min(1000px,100%)}
.frame{padding:10px;border-radius:6px;background:linear-gradient(135deg,#f7e7ce,#D4AF37 40%,#6e5514 70%,#D4AF37);box-shadow:0 0 35px var(--glow);cursor:zoom-in;transition:transform .5s,box-shadow .5s}
.frame:hover{transform:translateY(-8px) rotate(-.6deg);box-shadow:0 0 60px rgba(212,175,55,.7)}
.frame img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border:3px solid #050505}
#lb{position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.94);display:none;place-items:center;padding:1rem;cursor:zoom-out}
#lb.open{display:grid}
#lb img{max-width:100%;max-height:92vh;border:8px solid var(--gold);box-shadow:0 0 60px var(--glow);animation:pop2 .5s}
@keyframes pop2{from{opacity:0;transform:scale(.85)}}
/* message */
.letter{max-width:720px;padding:clamp(1.5rem,5vw,3.2rem);text-align:left}
.letter p{margin-bottom:1.1rem;line-height:1.7;opacity:0;transform:translateY(14px);transition:opacity 1.2s,transform 1.2s}
.letter p.in{opacity:1;transform:none}
.letter .sig{text-align:right;font-style:italic;color:var(--gold)}
.si{font-family:'Noto Sans Sinhala',sans-serif;font-size:1.05rem;line-height:1.95}
.hr{height:1px;margin:1.8rem 0;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
/* surprise */
#cakewrap{display:none;flex-direction:column;align-items:center}
.scene{perspective:900px;height:260px;margin:1rem 0 2rem}
.cake{position:relative;width:200px;height:230px;transform-style:preserve-3d;animation:rot 9s linear infinite}
@keyframes rot{to{transform:rotateX(-12deg) rotateY(360deg)}}
.cake{transform:rotateX(-12deg)}
.tier{position:absolute;left:50%;transform:translateX(-50%);border-radius:14px 14px 10px 10px;box-shadow:inset 0 -10px 18px rgba(0,0,0,.35),0 0 25px var(--glow)}
.t1{bottom:0;width:200px;height:70px;background:repeating-linear-gradient(90deg,#b8902a 0 22px,#D4AF37 22px 44px)}
.t2{bottom:70px;width:150px;height:62px;background:repeating-linear-gradient(90deg,#f7e7ce 0 20px,#e6cfa0 20px 40px)}
.t3{bottom:132px;width:100px;height:56px;background:repeating-linear-gradient(90deg,#D4AF37 0 16px,#f0d37a 16px 32px)}
.t3:before{content:"";position:absolute;top:-6px;left:0;right:0;height:14px;border-radius:50%;background:#fff6d8}
.can{position:absolute;bottom:188px;width:6px;height:30px;background:linear-gradient(#fff,#D4AF37);border-radius:2px}
.fl{position:absolute;top:-17px;left:-3px;width:12px;height:17px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;background:radial-gradient(#fff,#ffb400 60%,transparent);box-shadow:0 0 14px #ffb400;animation:fk .25s ease-in-out infinite alternate}
@keyframes fk{to{transform:scale(.85,1.12) rotate(4deg)}}
#cakewrap h3{font-size:clamp(1.3rem,5.5vw,2.4rem);letter-spacing:.08em;max-width:18ch;margin-bottom:1.2rem}
#cakewrap p{max-width:34ch;font-style:italic;font-size:1.3rem;line-height:1.6;margin-bottom:2rem}
#burst{position:fixed;inset:0;z-index:70;pointer-events:none;background:radial-gradient(circle,rgba(255,230,150,.85),transparent 60%);opacity:0}
#burst.go{animation:flash 1.4s ease-out}
@keyframes flash{20%{opacity:1}to{opacity:0}}
.heart{position:fixed;bottom:-30px;z-index:65;color:var(--gold);text-shadow:0 0 12px var(--glow);pointer-events:none;animation:up linear forwards}
@keyframes up{to{transform:translateY(-110vh) rotate(25deg);opacity:0}}
/* final */
#final{position:fixed;inset:0;z-index:80;display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:1.5rem;background:radial-gradient(ellipse at 50% 40%,#2a2008,#050505 70%)}
#final.open{display:flex;animation:fi 1.5s}
@keyframes fi{from{opacity:0}}
#final h1{font-size:clamp(2.2rem,10vw,5.5rem);letter-spacing:.06em;line-height:1.1;margin:1rem 0}
#final p{font-style:italic;font-size:clamp(1.1rem,4vw,1.7rem);max-width:28ch;margin-bottom:2rem}
footer{position:relative;z-index:1;text-align:center;padding:3rem 1rem 5.5rem;border-top:1px solid rgba(212,175,55,.35);font-size:1rem}
footer b{font-family:'Cinzel',serif;letter-spacing:.2em;font-size:.8rem}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01s!important;transition-duration:.01s!important}}

/* secret letter */
#secret{position:relative}
.sl-title{font-size:clamp(1.15rem,4.6vw,1.7rem);max-width:24ch;line-height:1.7;margin-bottom:2.2rem}
.env-wrap{position:relative;display:grid;place-items:center;margin-bottom:2.6rem;padding:2.5rem 0 1rem}
.env-wrap:before{content:"";position:absolute;width:min(420px,95vw);height:260px;border-radius:50%;background:radial-gradient(circle,rgba(212,175,55,.28),transparent 65%);animation:glowp 3s ease-in-out infinite}
@keyframes glowp{50%{opacity:.45;transform:scale(1.08)}}
.env{--w:min(320px,76vw);position:relative;width:var(--w);height:calc(var(--w)*.66);perspective:900px;animation:envf 4s ease-in-out infinite;filter:drop-shadow(0 22px 22px rgba(0,0,0,.7)) drop-shadow(0 0 28px rgba(212,175,55,.35))}
@keyframes envf{50%{transform:translateY(-10px) rotateX(6deg) rotateY(-5deg)}}
.env.open{animation:none;transform:rotateX(4deg)}
.env>*{position:absolute}
.e-back{inset:0;border-radius:6px;background:linear-gradient(135deg,#8a6d1c,#D4AF37 45%,#6e5514)}
.e-card{left:6%;right:6%;top:8%;bottom:6%;z-index:2;border-radius:4px;background:linear-gradient(#fff6d8,#f1dcaa);transition:transform 1s cubic-bezier(.3,.7,.2,1) .7s;display:grid;place-items:center;color:#8a6d1c;font-size:1.4rem}
.e-card:before{content:"";position:absolute;left:14%;right:14%;top:22%;height:30%;background:repeating-linear-gradient(#b8902a55 0 2px,transparent 2px 10px)}
.env.open .e-card{transform:translateY(-62%)}
.e-front{inset:0;z-index:3;border-radius:6px;background:linear-gradient(160deg,#f7e7ce,#D4AF37 35%,#b8902a 65%,#7a5f17);clip-path:polygon(0 0,50% 54%,100% 0,100% 100%,0 100%)}
.e-front:after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 40%,rgba(255,255,255,.35) 50%,transparent 60%);background-size:250% 100%;animation:sheen 4s linear infinite}
@keyframes sheen{from{background-position:150% 0}to{background-position:-100% 0}}
.e-flap{left:0;right:0;top:0;height:56%;z-index:4;transform-origin:top center;background:linear-gradient(180deg,#fff2b8,#D4AF37 55%,#9a7a22);clip-path:polygon(0 0,100% 0,50% 100%);transition:transform .8s cubic-bezier(.5,0,.2,1),z-index 0s .35s}
.env.open .e-flap{transform:rotateX(180deg);z-index:1}
.e-seal{left:50%;top:56%;width:44px;height:44px;margin:-22px 0 0 -22px;z-index:5;display:grid;place-items:center;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ff9a9a,#c1121f 60%,#7a0a12);color:#ffe9a8;font-size:1.3rem;box-shadow:0 0 18px rgba(255,200,80,.85),inset 0 -3px 6px rgba(0,0,0,.4);animation:beat 1.4s ease-in-out infinite;transition:opacity .3s}
@keyframes beat{50%{transform:scale(1.14)}}
.env.open .e-seal{opacity:0;animation:none}
.env-p{position:absolute;inset:-50px;pointer-events:none}
.env-p i{position:absolute;width:4px;height:4px;border-radius:50%;background:#f7e7ce;box-shadow:0 0 8px #D4AF37;animation:dust 5s ease-in infinite;opacity:0}
@keyframes dust{0%{transform:translateY(40px);opacity:0}30%{opacity:1}100%{transform:translateY(-90px);opacity:0}}
#openLetter:disabled{opacity:.7;cursor:default}
/* letter overlay */
#lt{position:fixed;inset:0;z-index:85;display:none;overflow-y:auto;background:radial-gradient(ellipse at 50% 30%,#2a2008,#050505 72%);-webkit-overflow-scrolling:touch}
#lt.open{display:block;animation:fi 1s}
.lt-in{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:calc(3rem + env(safe-area-inset-top,0px)) 1rem 3rem;perspective:1100px}
.paper{position:relative;width:min(640px,100%);padding:clamp(1.4rem,5vw,2.8rem);text-align:left;transform-origin:top center;background:linear-gradient(160deg,rgba(247,231,206,.07),rgba(212,175,55,.05));animation:unfold 1.5s cubic-bezier(.2,.7,.2,1) both}
@keyframes unfold{0%{transform:rotateX(-100deg) scaleY(.15);opacity:0}45%{opacity:1;transform:rotateX(-35deg) scaleY(.6)}100%{transform:none;opacity:1}}
.paper:before{content:"";position:absolute;inset:0;border-radius:22px;pointer-events:none;background:linear-gradient(transparent 32%,rgba(212,175,55,.2) 33%,transparent 34%,transparent 65%,rgba(212,175,55,.2) 66%,transparent 67%);animation:crease 1.6s 1.2s both}
@keyframes crease{to{opacity:0}}
.paper p{margin-bottom:1rem;opacity:0;transform:translateY(12px);transition:opacity 1s,transform 1s}
.paper p.in{opacity:1;transform:none}
.paper .sig{text-align:right;color:var(--gold)}
.bigheart{width:min(150px,38vw);margin:1.6rem 0 1rem;opacity:0;transform:scale(.4);transition:opacity .6s,transform .8s}
.bigheart.in{opacity:1;transform:none;filter:drop-shadow(0 0 22px rgba(212,175,55,.9))}
.bigheart path{fill:url(#g);fill-opacity:0;stroke:#fff2b8;stroke-width:1.5;stroke-dasharray:320;stroke-dashoffset:320}
.bigheart.in path{animation:draw 2s ease forwards}
.bigheart.in svg{animation:beat 1.2s 2s ease-in-out infinite}
@keyframes draw{60%{stroke-dashoffset:0;fill-opacity:0}to{stroke-dashoffset:0;fill-opacity:1}}
.lh{position:absolute;bottom:-30px;color:var(--gold);text-shadow:0 0 12px var(--glow);pointer-events:none;animation:up linear forwards}
#fx.top{z-index:86}

/* premium cake cut */
.cutwrap{display:flex;flex-direction:column;align-items:center;margin:0 0 2rem}
.cutq{font-size:clamp(1.1rem,4.6vw,1.6rem);margin-bottom:1.2rem;line-height:1.7}
.cutcake{position:relative;width:min(280px,74vw);height:200px;margin:2.5rem 0 1.5rem;filter:drop-shadow(0 18px 18px #000) drop-shadow(0 0 24px rgba(212,175,55,.3))}
.cutcake>*{position:absolute}
.cplate{left:-8%;right:-8%;bottom:-10px;height:12px;border-radius:50%;background:linear-gradient(#f7e7ce,#8a6d1c)}
.cb,.sl{height:80px;bottom:0;background:linear-gradient(90deg,#000,#1a1a1a 50%,#000);border-top:5px solid #D4AF37;border-radius:6px 6px 4px 4px;background-image:radial-gradient(circle at 50% 100%,#D4AF37 0 3px,transparent 4px),linear-gradient(90deg,#000,#1c1c1c 50%,#000);background-size:22px 14px,100% 100%;background-repeat:repeat-x,no-repeat;background-position:0 70%,0 0}
.cb{left:0;right:0}
.ct{left:18%;width:50%;height:62px;bottom:80px;border-radius:6px;background:linear-gradient(90deg,#8a6d1c,#f7e7ce 40%,#D4AF37 70%,#8a6d1c);border-top:9px solid #fff6d8;box-shadow:inset 0 -8px 12px rgba(0,0,0,.3)}
.cc{width:6px;height:30px;bottom:142px;border-radius:2px;background:linear-gradient(#fff,#D4AF37)}
.inn{left:70%;width:26%;height:80px;bottom:0;background:linear-gradient(#f7e7ce 0 14%,#6b3b1a 14% 40%,#D4AF37 40% 46%,#3b1f0d 46% 72%,#f7e7ce 72% 80%,#6b3b1a 80%)}
.sl{left:70%;width:26%;z-index:3;transform-origin:bottom left;transition:transform 1.4s cubic-bezier(.3,.7,.2,1)}
.sl i{position:absolute;inset:0;opacity:0;transition:opacity .6s .5s;background:linear-gradient(#f7e7ce 0 14%,#6b3b1a 14% 40%,#D4AF37 40% 46%,#3b1f0d 46% 72%,#f7e7ce 72% 80%,#6b3b1a 80%)}
.cl{left:70%;top:120px;width:3px;height:0;z-index:4;background:#fff;box-shadow:0 0 10px #ffd966,0 0 20px #D4AF37;transition:height .9s linear}
.kn{left:70%;top:-70px;width:26px;margin-left:-13px;z-index:5;opacity:0;transform:translate(90px,-30px) rotate(28deg);transition:transform 1s ease,opacity .6s;filter:drop-shadow(0 0 8px rgba(255,255,255,.5))}
.cutcake.k1 .kn{opacity:1;transform:translate(0,60px)}
.cutcake.k2 .kn{transform:translate(0,140px);transition-duration:.9s;transition-timing-function:linear}
.cutcake.k2 .cl{height:80px}
.cutcake.k3 .kn{opacity:0;transform:translate(60px,160px) rotate(40deg)}
.cutcake.k3 .sl{transform:translate(70%,18px) rotate(9deg)}
.cutcake.k3 .sl i{opacity:1}
.cutdone{font-size:clamp(1.2rem,5vw,1.8rem);line-height:1.7;opacity:0;transform:translateY(14px);transition:opacity 1s,transform 1s;margin-bottom:1.5rem}
.cutdone.in{opacity:1;transform:none}
#cutbtn:disabled{opacity:.6;cursor:default}
/* gift box */
#gift .gbox{position:relative;width:130px;height:130px;margin:5rem 0 2rem;cursor:pointer;background:none;border:0;perspective:600px;transform:rotateX(-10deg) rotateY(-14deg);transform-style:preserve-3d;animation:envf 4s ease-in-out infinite}
.gbody{position:absolute;left:5px;right:5px;bottom:0;height:92px;background:linear-gradient(135deg,#fff2b8,#D4AF37 40%,#7a5f17);border-radius:4px;box-shadow:0 0 30px var(--glow)}
.gbody:before,.glid:before{content:"";position:absolute;left:44%;width:12%;top:0;bottom:0;background:linear-gradient(90deg,#8a0f1a,#e23a49,#8a0f1a)}
.glid{position:absolute;left:-3px;right:-3px;top:2px;height:40px;background:linear-gradient(135deg,#fff6d8,#D4AF37 45%,#8a6d1c);border-radius:5px;transform-origin:left bottom;transition:transform 1s cubic-bezier(.3,.7,.2,1);z-index:2;box-shadow:0 4px 14px rgba(0,0,0,.5)}
.glid:after{content:"♥";position:absolute;left:50%;top:-14px;transform:translateX(-50%);font-size:1.7rem;color:#e23a49;text-shadow:0 0 10px #ffd966}
.gbox.open .glid{transform:translate(-30px,-46px) rotate(-38deg)}
.gl{position:absolute;left:50%;bottom:80px;width:220px;height:260px;margin-left:-110px;pointer-events:none;background:radial-gradient(ellipse at 50% 100%,rgba(255,225,130,.9),rgba(212,175,55,.35) 40%,transparent 70%);transform:scaleY(0);transform-origin:bottom;opacity:0;transition:transform 1s .2s,opacity 1s .2s;z-index:1}
.gbox.open .gl{transform:scaleY(1);opacity:1}
.gmsg{font-size:clamp(1.1rem,4.6vw,1.6rem);line-height:1.7;opacity:0;transform:translateY(14px);transition:opacity 1.2s,transform 1.2s;max-width:26ch}
.gmsg.in{opacity:1;transform:none}
/* gallery + player */
.frame{transform-style:preserve-3d;will-change:transform}
#ss{margin-top:2.2rem}
.live .eq i{animation:none;transition:height .08s}
#fx.fwtop{z-index:66}

/* performance */
.paused,.paused *{animation-play-state:paused!important}
.env,.gbox,.cake,.crown,.heart,.lh,.kn,.sl,.glid,.e-card,.e-flap{will-change:transform}
.btn,.pbtn,.frame,#gbox{touch-action:manipulation}
.rv{will-change:opacity,transform}.rv.in{will-change:auto}
@media(max-width:700px){.glass{backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}.env{filter:drop-shadow(0 14px 14px rgba(0,0,0,.7))}.cutcake{filter:drop-shadow(0 12px 12px #000)}}
</style></head>
<body class="lock">
<canvas id="fx"></canvas>
